FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY . .

RUN dotnet publish MeridianServer/MeridianServer.csproj \
    -c Release \
    -f net8.0 \
    -o /out/server

RUN dotnet publish MeridianTestLogic/MeridianTestLogic.csproj \
    -c Release \
    -o /out/testlogic

FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app

COPY --from=build /out/server/ ./
RUN mkdir -p /app/MeridianTest
COPY --from=build /out/testlogic/MeridianTestLogic.dll /app/MeridianTest/
COPY --from=build /out/testlogic/MeridianTestContracts.dll /app/MeridianTest/
COPY --from=build /out/testlogic/MeridianRequestSystem.dll /app/MeridianTest/

COPY MeridianServer/docker/server_setting.json /app/server_setting.json

EXPOSE 4555
ENTRYPOINT ["dotnet", "MeridianServer.dll"]
